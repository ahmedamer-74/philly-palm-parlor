<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="ph-theme-build" content="pheladelfia-20261119-v2">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>(function(){
    try{
      var add=EventTarget.prototype.addEventListener, rem=EventTarget.prototype.removeEventListener;
      EventTarget.prototype.addEventListener=function(t,f,o){ if(t==="unload" && this===window){ t="pagehide"; } return add.call(this,t,f,o); };
      EventTarget.prototype.removeEventListener=function(t,f,o){ if(t==="unload" && this===window){ t="pagehide"; } return rem.call(this,t,f,o); };
    }catch(e){}
    try{
      var l=localStorage.getItem("ph_lang")||((document.cookie.match(/(?:^|; )ph_lang=([^;]+)/)||[])[1])||"ar";
      if(l==="ar"){
        var h=document.documentElement;
        h.setAttribute("lang","ar"); h.setAttribute("dir","rtl"); h.className+=" ph-ar";
        document.write('<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap">');
      }
    }catch(e){}
  })();</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap">
  <title>{% if page.title %}{{ page.title }}{% else %}Pheladelfia{% endif %}</title>
  {{ page.meta_tags }}
  {{ page.stylesheets }}
  {{ page.header_code }}
  <style type="text/css">{{ page.custom_css }}</style>
</head>
<body class="ph-body{% if page.is_home_page %} is-home{% endif %}">

<header class="ph-header">
  <!-- Announcement bar -->
  <div class="ph-topbar">
    <div class="ph-wrap">
      <span class="ph-topbar-msg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
        Premium Palms &amp; Trees — Grown in the UAE
      </span>
      <span class="ph-topbar-contact">
        <a href="tel:+97125551662" dir="ltr">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          +971 2 555 1662
        </a>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          Sat–Thu 8am–6pm · Friday closed
        </span>
      </span>
    </div>
  </div>

  <!-- Main bar -->
  <div class="ph-header-top">
    <button class="ph-icon-btn ph-menu-toggle" type="button" data-ph-menu-toggle aria-label="Open menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a class="ph-logo" href="/" aria-label="Pheladelfia home">
      {% if page.logo.url %}
      <img class="ph-store-logo" src="{{ page.logo.url }}" alt="Pheladelfia Agricultural">
      {% else %}
      <img class="ph-store-logo" src="{{ page.template_assets }}/images/logo-mark.png" alt="Pheladelfia Agricultural" onerror="this.style.display='none'">
      {% endif %}
      <span class="ph-logo-sub">
        <b>Pheladelfia</b>
        <span>Agricultural LLC</span>
      </span>
    </a>

    <form class="ph-search" action="{% if page.search_url %}{{ page.search_url }}{% else %}/search{% endif %}" method="get" role="search">
      <select aria-label="All categories" data-ph-search-filter>
        <option value="">All categories</option>
        <option value="outdoor">Outdoor</option>
        <option value="indoor">Indoor</option>
      </select>
      <input type="search" name="q" placeholder="Search palms, trees, shrubs…" aria-label="Search" autocomplete="off">
      <button type="submit" aria-label="Search">Search</button>
    </form>

    <div class="ph-header-tools">
      <button class="ph-lang" type="button" data-ph-lang-toggle data-ph-no-translate aria-label="English / العربية">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
        <span class="ph-lang-to-ar" lang="ar"><span class="ph-lang-word">العربية</span></span>
        <span class="ph-lang-to-en" lang="en"><span class="ph-lang-word">EN</span></span>
      </button>
      {% if page.is_portal_enabled %}
      <span class="ph-account">
        <a class="ph-account-link ph-auth-btn ph-auth-signin" href="/signin">Sign in</a>
        <a class="ph-account-link ph-auth-btn ph-auth-register" href="/account">Account</a>
        <a class="ph-icon-btn" href="/account/wishlist" aria-label="Wishlist" title="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z"/></svg>
        </a>
      </span>
      {% endif %}
      <a class="ph-icon-btn" href="/cart" aria-label="Your cart" data-ph-cart-link aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h15l-1.6 9H8L6 7z"/><path d="M6 7L5 4H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        {% include "_store-cart-count" %}
      </a>
    </div>
  </div>

  <!-- Nav (desktop row / mobile drawer) -->
  <nav class="ph-nav" data-ph-nav aria-label="Main">
    <div class="ph-nav-head">
      <span class="ph-nav-title">Menu</span>
      <button class="ph-nav-close" type="button" data-ph-menu-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <ul class="ph-nav-list">
      <li><a href="/">Home</a></li>
      <li class="ph-drop ph-drop-mega">
        <a href="/all-collections">Collections</a>
        <div class="ph-drop-menu ph-mega">
          <a class="ph-mega-all" href="/all-collections">All collections <span aria-hidden="true">→</span></a>
          <div class="ph-mega-col">
            <h5>Outdoor Plants</h5>
            <a href="/categories/palm_trees/1149036000001419436">Palm Trees</a>
            <a class="ph-mega-sub" href="/categories/washingtonia-robusta-واشنطونيا-روبوستا/1149036000001419475">Washingtonia robusta</a>
            <a href="/categories/trees/1149036000001419439">Trees</a>
            <a href="/categories/large_rare_ancient_trees/1149036000001419442">Rare &amp; Ancient Trees</a>
            <a href="/categories/cacti_succulents/1149036000001419445">Cacti &amp; Succulents</a>
          </div>
          <div class="ph-mega-col">
            <h5>Outdoor Plants</h5>
            <a href="/categories/shrubs_ground_cover_plants/1149036000001419454">Shrubs &amp; Ground Cover</a>
            <a href="/categories/climbers/1149036000001419457">Climbers</a>
            <a href="/categories/art_section_sculptures/1149036000001419469">Art &amp; Sculptures</a>
          </div>
          <div class="ph-mega-col">
            <h5>Indoor &amp; Decor</h5>
            <a href="/categories/indoor_ornamental_plants/1149036000001419448">Indoor Ornamental Plants</a>
            <a href="/categories/fresh_flowers_floral_bouquets/1149036000001419460">Fresh Flowers &amp; Bouquets</a>
            <a href="/categories/artificial_plants/1149036000001419451">Artificial Plants</a>
          </div>
          <div class="ph-mega-col">
            <h5>Garden &amp; Nursery Supply</h5>
            <a href="/categories/fertilizers_soil_amendments/1149036000001419466">Fertilizers &amp; Soil Amendments</a>
            <a href="/categories/seeds_planting_stock/1149036000001419463">Seeds &amp; Planting Stock</a>
            <a href="/categories/tools_equipment_direct_purchases/1149036000001419472">Tools &amp; Equipment</a>
          </div>
        </div>
      </li>
      <li><a href="/services">Services</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
      <li class="ph-nav-cta-item"><a class="ph-nav-cta" href="/categories/palm_trees/1149036000001419436">Shop palms <span class="ph-arrow" aria-hidden="true">→</span></a></li>
    </ul>
    <div class="ph-nav-extra">
      <a class="ph-btn" href="/contact">Inquire</a>
      {% if page.is_portal_enabled %}
      <a class="ph-auth-btn ph-auth-signin" href="/signin">Sign in</a>
      <a class="ph-auth-btn ph-auth-register" href="/signup">Register</a>
      <div class="ph-nav-contact"><a href="/account/wishlist">Wishlist</a></div>
      {% endif %}
    </div>
  </nav>
  <div class="ph-nav-backdrop" data-ph-menu-close></div>
</header>

{% block content %}{% endblock %}

<!-- Cart drawer -->
<div class="ph-drawer" data-ph-drawer>
  <div class="ph-drawer-backdrop" data-ph-drawer-close></div>
  <aside class="ph-drawer-panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="ph-drawer-head">
      <div>
        <p class="ph-kicker">Nursery</p>
        <h2 class="ph-drawer-title">Your selection</h2>
      </div>
      <button class="ph-icon-btn" type="button" data-ph-drawer-close aria-label="Close selection">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <div class="ph-drawer-body" data-ph-drawer-items></div>
    <footer class="ph-drawer-foot" data-ph-drawer-foot hidden>
      <div class="ph-drawer-sub">
        <span>Subtotal</span>
        <strong data-ph-drawer-subtotal></strong>
      </div>
      <p class="ph-drawer-note">Exclusive of 5% VAT · Delivered across the UAE</p>
      <a class="ph-btn" data-ph-drawer-checkout href="/checkout">Continue to checkout</a>
      <a class="ph-text-link" href="/cart">View full selection</a>
    </footer>
  </aside>
</div>

<footer class="ph-footer">
  <div class="ph-wrap">
    <div class="ph-footer-grid">
      <div>
        <span class="ph-footer-logo">
          <img src="{{ page.template_assets }}/images/logo-full.png" alt="Pheladelfia Agricultural LLC" onerror="this.parentElement.style.display='none'">
        </span>
        <p class="ph-footer-about">Growing premium palms, trees and shrubs in Abu Dhabi since 2004 — and creating landscapes across the UAE.</p>
      </div>
      <div>
        <h3>Shop</h3>
        <ul>
          <li><a href="/categories/palm_trees/1149036000001419436">Palm Trees</a></li>
          <li><a href="/categories/trees/1149036000001419439">Trees</a></li>
          <li><a href="/categories/shrubs_ground_cover_plants/1149036000001419454">Shrubs &amp; Ground Cover</a></li>
          <li><a href="/categories/indoor_ornamental_plants/1149036000001419448">Indoor Plants</a></li>
          <li><a href="/categories/fertilizers_soil_amendments/1149036000001419466">Pots &amp; Supplies</a></li>
          <li><a href="/all-collections">All collections</a></li>
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/contact">Contact</a></li>
          {% if page.is_portal_enabled %}<li><a href="/account">My account</a></li>{% endif %}
        </ul>
      </div>
      <div>
        <h3>Visit &amp; contact</h3>
        <ul class="ph-footer-contact">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>Nursery: Al Wathba, Abu Dhabi<br>Branch: Al Quoz, Dubai</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            <a href="tel:+97125551662" dir="ltr">+971 2 555 1662</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <a href="mailto:nursery@pheladelfia.com">nursery@pheladelfia.com</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            <span>Sat–Thu 8am–6pm · Friday closed</span>
          </li>
        </ul>
      </div>
    </div>
    <div class="ph-social" aria-label="Social media">
      <a class="ph-social-link" href="https://www.instagram.com/pheladelfiaagri/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      <a class="ph-social-link" href="https://www.facebook.com/pheladelfiaagri/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21h3z"/></svg></a>
      <a class="ph-social-link" href="https://www.linkedin.com/company/pheladelfiaagri/" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zm7 0h3.8v1.5h.1c.5-.95 1.8-1.95 3.7-1.95 4 0 4.7 2.6 4.7 6v5.45h-4v-4.8c0-1.15 0-2.65-1.6-2.65s-1.9 1.25-1.9 2.55v4.9h-4z"/></svg></a>
      <a class="ph-social-link" href="https://x.com/pheladelfiaagri" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
    </div>
    <div class="ph-footer-bottom">
      <span>© <span data-ph-year>2026</span> Pheladelfia Agricultural LLC. All rights reserved.</span>
      <span>Prices in AED, excluding 5% VAT.</span>
    </div>
  </div>
</footer>

<a class="ph-wa" href="https://wa.me/97125551662" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <span class="ph-wa-icon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.33 4.94L2 22l5.39-1.41a10.1 10.1 0 0 0 4.65 1.14h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.76 13.84c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.81-.11-.41-.14-.95-.31-1.63-.61-2.87-1.24-4.74-4.13-4.88-4.32-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.24-.27.64-.39.85-.39.21 0 .42 0 .6.01.19.01.45-.07.7.53.26.63.88 2.16.96 2.32.08.16.13.34.03.55-.1.21-.16.34-.31.52-.16.18-.33.4-.47.54-.16.16-.32.33-.14.64.19.31.83 1.37 1.78 2.22 1.22 1.09 2.25 1.43 2.57 1.59.32.16.5.13.69-.08.19-.21.8-.93 1.01-1.25.21-.32.42-.27.7-.16.29.11 1.82.86 2.13 1.01.31.16.52.24.6.37.08.13.08.76-.16 1.44z"/></svg>
    <span class="ph-wa-dot"></span>
  </span>
  <span class="ph-wa-label">Chat on WhatsApp</span>
</a>

{{ page.scripts }}
{{ page.footer_code }}
</body>
</html>
