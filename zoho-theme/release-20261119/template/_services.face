    <!-- Service 03 -->
    <article class="ph-split" id="interior">
      <div class="ph-gold-frame"><img src="{{ page.template_assets }}/images/indoor-plants.jpg" alt="Interior plant maintenance" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:1rem;"></div>
      <div>
        <span class="ph-eyebrow">Service 03</span>
        <h2 class="ph-sec-title" style="margin-block-start:0.8rem;">Interior Plant Maintenance</h2>
