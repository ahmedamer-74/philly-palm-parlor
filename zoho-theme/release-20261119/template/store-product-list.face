<article class="ph-product-card" data-ph-product-card data-ph-product-id="{{ product.product_id }}" data-ph-options="">   <a href="{{ product.url }}">     <div class="ph-product-photo" data-ph-gallery>{% include "_store-product-image" %}</div>     <div class="ph-card-body">       {% if product.category_name %}<p class="ph-kicker">{{ product.category_name }}</p>{% endif %}       <h3 class="ph-h3">{{ product.name }}</h3>       {% if product.short_description %}<p class="ph-copy">{{ product.short_description }}</p>{% endif %}       {% include "_store-product-pricing" %}       <span class="ph-more">View specimen</span>     </div>   </a>   <span hidden data-ph-option-source>{% for attribute in product.attributes %}{% for option in attribute.options %}{{ option.id }} {% endfor %}{% endfor %}</span> </article> 