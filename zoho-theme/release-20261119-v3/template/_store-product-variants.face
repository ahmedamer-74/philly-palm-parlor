<select hidden data-zs-variants>   <option value="-1" data-zs-attributes="[]"></option>   {% for variant in product.variants %}   <option value="{{ variant.variant_id }}" data-ph-option-ids="{% for option in variant.options %}{{ option.id }} {% endfor %}" data-zs-attributes="[]">{{ variant.sku }}</option>   {% endfor %} </select> {% if product.variants %} <div class="ph-variant-fields">   <p class="ph-field-label">Size <span data-ph-size-label></span></p>   <div class="ph-size-chips" data-ph-size-chips>     {% for variant in product.variants %}     <button type="button" class="ph-size-chip" data-ph-size-chip data-ph-variant-id="{{ variant.variant_id }}">{% for option in variant.options %}{{ option.value }}{% endfor %}</button>     {% endfor %}   </div> </div> {% endif %} {% if product.attributes %}   {% for attribute in product.attributes %}   <select class="ph-select ph-sr-only" data-zs-attribute-select data-zs-attribute-id="{{ attribute.id }}" aria-label="{{ attribute.name }}">     <option value="">Select {{ attribute.name }}</option>     {% for option in attribute.options %}     <option value="{{ option.id }}">{{ option.value }}</option>     {% endfor %}   </select>   {% endfor %} {% else %}   {% if product.variants %}   <select class="ph-select ph-sr-only" data-ph-variant-pick aria-label="Size">     <option value="">Select size</option>     {% for variant in product.variants %}     <option value="{{ variant.variant_id }}">{% for option in variant.options %}{{ option.value }} {% endfor %}{{ variant.sku }}</option>     {% endfor %}   </select>   {% endif %} {% endif %} 