{% extends "_theme" %} {% block content %} <section class="ph-page-hero">   <div class="ph-wrap">     <p class="ph-kicker">Collection</p>     <h1 class="ph-h2">{{ collection.name }}</h1>     {% if collection.description %}<div class="ph-lead">{{ collection.description }}</div>{% endif %}   </div> </section> <section class="ph-store">   <div class="ph-wrap">     <div class="ph-product-grid" data-ph-product-grid>       {% for product in collection.products %}       {% include "store-product-list" %}       {% endfor %}     </div>     {% if no_products_message %}     <p class="ph-lead">{{ no_products_message }}</p>     {% endif %}   </div> </section> {% endblock %} 