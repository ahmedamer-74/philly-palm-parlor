{% extends "_theme" %} {% block content %} <section class="ph-store ph-selection-page">   <div class="ph-wrap">     <p class="ph-kicker">Nursery</p>     <h1 class="ph-h2">Your selection</h1>     {% if cart.items %}     <div class="ph-selection-layout">       <div class="ph-selection-list" data-cart-items>         {% for item in cart.items %}         <article class="ph-selection-row" data-ph-cart-row data-ph-item-url="{{ item.url }}" data-zs-product-id="" data-zs-product-variant-id="" data-zs-product-wrapper-lineitem-id="">           <div class="ph-selection-photo" data-ph-cart-photo></div>           <div class="ph-selection-info">             <a class="ph-selection-name" href="{{ item.url }}">{{ item.name }}</a>             <p class="ph-copy" data-ph-cart-meta></p>             <p class="ph-price" data-ph-cart-unit></p>           </div>           <div class="ph-selection-qty">             <button class="ph-qty-btn" type="button" data-ph-qty-minus aria-label="Decrease quantity">-</button>             <input class="ph-qty" type="number" min="1" value="{{ item.quantity }}" data-zs-quantity aria-label="Quantity">             <button class="ph-qty-btn" type="button" data-ph-qty-plus aria-label="Increase quantity">+</button>           </div>           <div class="ph-selection-total" data-ph-cart-total>{{ cart.symbol }}{{ item.total_price }}</div>           <button class="ph-text-link ph-selection-remove" type="button" data-zs-delete data-ph-remove>Remove</button>         </article>         {% endfor %}       </div>       <aside class="ph-selection-summary">         <p class="ph-kicker">Summary</p>         <p class="ph-lead">Subtotal <strong data-ph-cart-subtotal>{{ cart.symbol }}{{ cart.sub_total }}</strong></p>         {% if cart.checkout_url %}         <a class="ph-btn" data-zs-checkout href="{{ cart.checkout_url }}">Continue to checkout</a>         {% endif %}         <a class="ph-text-link" href="/all-collections">Keep browsing</a>       </aside>     </div>     {% else %}     <p class="ph-lead">Your selection is empty.</p>     <a class="ph-btn" href="/all-collections">Browse collections</a>     {% endif %}   </div> </section> {% endblock %} 