{% extends "_theme" %} {% block content %} <section class="ph-store ph-product-page">   <div class="ph-wrap">     <nav class="ph-crumbs" aria-label="Breadcrumb">       <a href="/">Home</a>       {% for crumb in product.bread_crumbs %}       <span class="ph-crumb-sep">/</span>       {% if crumb.is_selected %}       <span>{{ crumb.name }}</span>       {% else %}       <a href="{{ crumb.url }}">{{ crumb.name }}</a>       {% endif %}       {% endfor %}     </nav>     <div class="ph-product-detail">       <div class="ph-gallery-col">         <div class="ph-product-gallery" data-ph-gallery data-ph-product-gallery>           <div class="ph-main-image" data-ph-main-image>{% include "_store-product-image" %}</div>           <div class="ph-thumbs" data-ph-thumbs></div>         </div>       </div>       <div class="ph-product-buy">         {% if product.category_name %}<p class="ph-kicker">{{ product.category_name }}</p>{% endif %}         <h1 class="ph-h2">{{ product.name }}</h1>         <div class="ph-price-row">           <div class="ph-price" data-ph-price data-zs-selling-price="{{ product.selling_price }}">             {% if product.has_variant_price %}{{ currency.symbol }}{{ product.starts_with }} – {{ currency.symbol }}{{ product.ends_with }}{% else %}{{ currency.symbol }}{{ product.selling_price }}{% endif %}           </div>           <p class="ph-price-note">Exclusive of 5% VAT{% if product.unit %} · Sold as {{ product.unit }}{% endif %}</p>         </div>         <div class="ph-product-meta">           <span data-ph-sku></span>           <span class="ph-stock" data-ph-stock hidden></span>         </div>         {% if product.short_description %}<div class="ph-lead">{{ product.short_description }}</div>{% endif %}         {% include "_store-product-variants" %}         <div class="ph-buy">           <div class="ph-buy-row">             <div class="ph-qty-box">               <button type="button" class="ph-qty-btn" data-ph-qty-minus aria-label="Decrease quantity">−</button>               <input class="ph-qty" data-zs-quantity type="number" min="1" value="1" aria-label="Quantity">               <button type="button" class="ph-qty-btn" data-ph-qty-plus aria-label="Increase quantity">+</button>             </div>             <button class="ph-btn" type="button" data-zs-add-to-cart data-zs-product-id="{{ product.product_id }}">Add to selection</button>           </div>           <p class="ph-buy-error" data-theme-error style="display:none;"></p>           <p class="ph-buy-ok" data-ph-buy-ok hidden></p>         </div>         <p class="ph-actions"><a class="ph-text-link" href="/cart" data-ph-open-cart>View selection</a> · <a class="ph-text-link" href="/contact">Inquire about this specimen</a> · <button type="button" class="ph-text-link" data-zs-add-to-quote>Request a quote</button> <button type="button" class="ph-icon-btn" data-zs-wishlist-element aria-label="Save to wishlist" title="Wishlist">Wishlist</button></p>         <ul class="ph-trust">           <li>Stock held at Farm 563 &amp; 564, Al Ajban, Abu Dhabi</li>           <li>Clear-trunk (CT) heights, priced per specimen</li>           <li>Landscape trade lists and project quotes on request</li>         </ul>       </div>     </div>     <section class="ph-product-panel">       <p class="ph-kicker">Specimen</p>       <h2 class="ph-h3">Details</h2>       <dl class="ph-spec">         <div class="ph-spec-row">           <dt>Species</dt>           <dd>{{ product.category_name }}</dd>         </div>         <div class="ph-spec-row">           <dt>Size</dt>           <dd data-ph-spec-size>—</dd>         </div>         <div class="ph-spec-row">           <dt>SKU</dt>           <dd data-ph-spec-sku>—</dd>         </div>         <div class="ph-spec-row">           <dt>Unit</dt>           <dd>{% if product.unit %}{{ product.unit }}{% else %}NOS{% endif %}</dd>         </div>         <div class="ph-spec-row">           <dt>Availability</dt>           <dd data-ph-spec-stock>—</dd>         </div>       </dl>       {% if product.description %}<div class="ph-copy" style="margin-top:24px;">{{ product.description }}</div>{% endif %}     </section>     <p class="ph-copy" style="margin-top:32px;"><a class="ph-text-link" href="/all-collections">Back to collections</a></p>   </div> </section> {% endblock %} 