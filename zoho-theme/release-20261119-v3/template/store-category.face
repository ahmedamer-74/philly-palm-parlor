{% extends "_theme" %} {% block content %} <section class="ph-page-hero">   <div class="ph-wrap">     <p class="ph-kicker">Collection</p>     <h1 class="ph-h2">{{ category.name }}</h1>     {% if category.description %}<div class="ph-lead">{{ category.description }}</div>{% endif %}     {% if category.images %}       {% for image in category.images %}         <div class="ph-photo ph-category-hero-photo" style="background-image:url('{{ image.url }}/1600x1600');" role="img" aria-label="{{ category.name }}"></div>       {% endfor %}     {% endif %}   </div> </section> <section class="ph-store">   <div class="ph-wrap">     {% if category.sub_categories %}     <div class="ph-cat-group" data-ph-subcats>       <p class="ph-kicker">Species and sub-collections</p>       <div class="ph-product-grid ph-category-grid" data-ph-subcat-grid>         {% for sub in category.sub_categories %}         <a class="ph-product-card" href="{{ sub.url }}" data-ph-cat-id="{{ sub.category_id }}">           <div class="ph-card-photo" data-ph-cat-photo="{{ sub.category_id }}">             {% for image in sub.images %}               {% if image.is_placeholder_image %}               {% else %}               <span hidden data-ph-real-photo="{{ image.url }}/1600x1600"></span>               {% endif %}             {% endfor %}           </div>           <div class="ph-card-body">             <h3 class="ph-h3">{{ sub.name }}</h3>             <span class="ph-more">View specimens</span>           </div>         </a>         {% endfor %}       </div>     </div>     {% endif %}     <div class="ph-catalog-main">       <div class="ph-product-grid" data-ph-product-grid>         {% for product in category.products %}         {% include "store-product-list" %}         {% endfor %}       </div>       <p class="ph-copy" style="margin-top:32px;"><a class="ph-btn" href="/all-collections">All collections</a></p>     </div>   </div> </section> {% endblock %} 