<aside class="ph-filters" data-ph-filters>   <p class="ph-kicker">Refine</p>   <h2 class="ph-h3">Filter the catalog</h2>   {% if category.sub_categories %}   <div class="ph-filter-group" data-ph-filter-group="species">     <h3 class="ph-filter-title">Species</h3>     <ul class="ph-filter-list">       {% for sub in category.sub_categories %}       <li><a href="{{ sub.url }}" data-ph-cat-id="{{ sub.category_id }}">{{ sub.name }}</a></li>       {% endfor %}     </ul>   </div>   {% endif %}   {% if filters %}     {% for set in filters.filter_set %}     <div class="ph-filter-group" data-ph-filter-type="{{ set.type_label }}" data-ph-filter-set="{{ set.id }}">       <h3 class="ph-filter-title">{{ set.name }}</h3>       {% for child in set.children_category_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="category" data-ph-id="{{ child.id }}">         <span>{{ child.name }}</span>         {% if set.show_product_count %}<em>{{ child.count }}</em>{% endif %}       </label>       {% endfor %}       {% for opt in set.attribute_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="attribute" data-ph-id="{{ opt.id }}" data-ph-container="{{ opt.container_id }}">         <span>{{ opt.name }}</span>         {% if set.show_product_count %}<em>{{ opt.count }}</em>{% endif %}       </label>       {% endfor %}       {% for opt in set.color_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="attribute" data-ph-id="{{ opt.id }}" data-ph-container="{{ opt.container_id }}">         <span>{{ opt.name }}</span>         {% if set.show_product_count %}<em>{{ opt.count }}</em>{% endif %}       </label>       {% endfor %}       {% for opt in set.price_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="price" data-ph-from="{{ opt.from }}" data-ph-to="{{ opt.to }}" data-ph-container="{{ opt.container_id }}">         <span>{{ opt.from }} – {{ opt.to }}</span>         {% if set.show_product_count %}<em>{{ opt.count }}</em>{% endif %}       </label>       {% endfor %}       {% for opt in set.brand_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="brand" data-ph-id="{{ opt.id }}">         <span>{{ opt.name }}</span>         {% if set.show_product_count %}<em>{{ opt.count }}</em>{% endif %}       </label>       {% endfor %}       {% for opt in set.tag_filter %}       <label class="ph-filter-opt">         <input type="checkbox" data-ph-filter="tag" data-ph-id="{{ opt.id }}">         <span>{{ opt.name }}</span>         {% if set.show_product_count %}<em>{{ opt.count }}</em>{% endif %}       </label>       {% endfor %}     </div>     {% endfor %}   {% endif %}   <div class="ph-filter-group" data-ph-size-host hidden>     <h3 class="ph-filter-title">Size</h3>     <div data-ph-size-options></div>   </div> </aside> 