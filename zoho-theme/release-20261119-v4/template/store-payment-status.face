{% extends '_theme' %} {% block content %} <section class="ph-store">   <div class="ph-wrap" style="text-align:center;">     {% if payment_status.order_placed %}     <h1 class="ph-h2">Order received</h1>     <p class="ph-lead">Thank you. Reference {{ payment_status.salesorder_number }} · {{ payment_status.amount_formatted }}</p>     {% else %}     <h1 class="ph-h2">Payment needs attention</h1>     <p class="ph-lead">{{ payment_status.error }}</p>     {% endif %}     <a class="ph-btn" href="/">Return home</a>   </div> </section> {% endblock %} 