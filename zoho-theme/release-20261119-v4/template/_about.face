<!-- Story -->
<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-split">
      <div>
        <span class="ph-eyebrow">Since 2004</span>
        <h2 class="ph-sec-title" style="margin-block-start:0.8rem;">From a single nursery to a UAE landscaping partner</h2>
        <div class="ph-copy" style="margin-block-start:1.5rem; display:flex; flex-direction:column; gap:1rem;">
          <p>Pheladelfia Agricultural LLC began in 2004 with a simple belief: plants for the UAE should be grown in the UAE. Our Abu Dhabi nursery acclimatizes every palm, tree and shrub to local heat, soil and water so it thrives from the day it is planted.</p>
          <p>Today we supply developers, contractors, hotels and government entities, and our landscaping and maintenance teams care for gardens, parks and interiors across all seven Emirates — supported by our branch in Dubai.</p>
        </div>
        <div class="ph-two-col" style="margin-block-start:2rem;">
          <div class="ph-info-card" style="display:flex; gap:0.8rem; align-items:flex-start;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" style="flex-shrink:0; margin-block-start:0.2rem;"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span class="ph-copy" style="font-size:0.9rem;">Nursery: Al Wathba, Abu Dhabi</span>
          </div>
          <div class="ph-info-card" style="display:flex; gap:0.8rem; align-items:flex-start;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" style="flex-shrink:0; margin-block-start:0.2rem;"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span class="ph-copy" style="font-size:0.9rem;">Branch: Al Quoz, Dubai</span>
          </div>
        </div>
      </div>
      <div class="ph-gold-frame">
        <img src="{{ page.template_assets }}/images/palm-single-specimen.jpg" alt="Specimen palm at the Pheladelfia nursery" style="width:100%; aspect-ratio:4/5; object-fit:cover; border-radius:1rem;">
      </div>
    </div>
  </div>
</section>

