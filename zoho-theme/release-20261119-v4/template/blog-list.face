{% extends "_theme" %} {% block content %} <section class="ph-projects">   <div class="ph-wrap">     <p class="ph-kicker">Journal</p>     <h1 class="ph-h2">Blog</h1>     <div class="ph-project-grid">       {% for post in blog_posts %}       <article class="ph-project-card">         <h3 class="ph-h3"><a href="{{ post.post_url }}">{{ post.post_title }}</a></h3>         <p>{{ post.summary }}</p>       </article>       {% endfor %}     </div>   </div> </section> {% endblock %} 